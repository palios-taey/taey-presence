# taey-presence-engine config. Copy to .env. NO CREDENTIALS — every service
# runs no-auth on your own trusted network. Engine fails LOUD on missing
# required keys rather than defaulting to anyone's host.

# Required: OpenAI-compatible model endpoint base URL (no /v1 suffix)
MODEL_ENDPOINT=

# Optional: model name sent in the request. Empty = omit it. Set this if your
# server rejects requests without a model (engine.py:181 reads it; it was live
# in production while missing from this file).
MODEL_NAME=

# Optional: your Redis (no auth). Defaults to localhost.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: retrieval backend URL for the MEMORY context. Empty = no memory.
SEARCH_URL=

# Optional: your no-auth Neo4j bolt URL for DCM inter-instance state.
# Empty = run standalone (no peer coordination).
NEO4J_BOLT=

# Optional: this instance's id (for DCM peer state)
INSTANCE_ID=presence-0
