# taey-presence — environment configuration
#
# Copy to `.env` and adjust. Every value below is also the in-code default, so
# the system runs out-of-the-box against services on localhost with NO auth.
# The local defaults assume trusted loopback services. DCM accepts explicit
# Neo4j credentials and refuses an unauthenticated non-loopback graph unless the
# operator deliberately sets DCM_ALLOW_INSECURE=1.
#
# The base presence workers have defaults. The Taey-native council variables
# below are required when that path is enabled.

# ── Redis (required service) — task/state bus the workers + dashboard share ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Model endpoint (required service) — any OpenAI-compatible chat endpoint ──
# Point at your local LLM (vLLM, llama.cpp --api, Ollama's /v1, etc.).
VLLM_URL=http://localhost:8000/v1/chat/completions
# Model name. Leave EMPTY for single-model servers (vLLM serves one model and
# ignores it). REQUIRED by servers that demand a model (Ollama's /v1 rejects
# requests with no model) — e.g. MODEL=qwen2.5:3b or MODEL=llama3.2:1b.
MODEL=

# ── Memory search (optional) — hybrid search backend for type-time prefetch ──
# Disable the memory feature by leaving your backend down; the worker degrades.
ISMA_URL=http://localhost:8095

# ── Graph store (optional) — DCM inter-worker state. Degrades to Redis-only ──
# if unreachable. No auth: the driver connects with no credentials.
NEO4J_URI=bolt://localhost:7687

# ── Edge inference host (optional) — a second box serving the model, e.g. an
# NVIDIA Jetson ("THOR_*"). Leave these EMPTY for the common single-endpoint
# launch: the dashboard will derive its chat base from VLLM_URL automatically.
# Set them only when you want the split topology override.
THOR_REDIS_HOST=localhost
THOR_REDIS_PORT=6379
THOR_PROXY=
THOR_RAW=

# ── Taey-native council (optional) — seven local supporting seats coordinated
# by the dashboard. The UI defaults council ON and requires the fleet-notify
# delivery daemon plus the seven `taey-council-seat@N` user units to be running.
TAEY_SESSIONS_DIR=~/taey_sessions
TAEY_COUNCIL_LOG_DIR=~/taey_sessions/council
TAEY_COUNCIL_WAVE_TIMEOUT=1800
TAEY_COUNCIL_POLL_INTERVAL=0.25
# Optional production-qualification subset of the canonical seven seats.
# Unset keeps all seven. A set value must be unique known taey-council-N IDs
# (comma or whitespace separated); empty, duplicate, or unknown IDs fail
# dashboard startup. Order is always the committed COUNCIL_SEATS/manifest order.
# TAEY_COUNCIL_ACTIVE_SEAT_IDS=taey-council-1
TAEY_SEAT_PROXY=http://127.0.0.1:8767/v1/chat/completions
TAEY_MODEL=ep3

# The public DCM graph is deliberation authority. Keep this distinct from the
# orchestrator graph and set both values explicitly for council dispatch.
DCM_NEO4J_URI=bolt://127.0.0.1:7687
DCM_NEO4J_DATABASE=neo4j
DCM_NEO4J_USER=
DCM_NEO4J_PASSWORD=
DCM_ALLOW_INSECURE=0

# The dashboard and every council seat independently verify the same short-lived
# signed serving-host publication before freezing or claiming model work.
TAEY_MODEL_IDENTITY_AUTHORITY_ID=thor2-worker-vllm
TAEY_MODEL_IDENTITY_REDIS_HOST=127.0.0.1
TAEY_MODEL_IDENTITY_REDIS_PORT=6379
TAEY_MODEL_IDENTITY_UPSTREAM_COMPLETION_ENDPOINT=http://model-host.internal.example:8000/v1/chat/completions
TAEY_MODEL_IDENTITY_EXPECTED_ALIASES=ep3 taey

# ── Telemetry source (optional) — host the soma daemon polls for GPU/system
# vitals ("SPARK_*" after the NVIDIA DGX Spark tier). localhost = poll self.
SOMA_SPARK_TARGET=localhost
SOMA_SPARK_POLL_INTERVAL=8.0
SOMA_SPARK_CACHE_MAX_AGE=16.0

# ── Face (optional) — resting emoji shown before the model reacts. Empty means
# show nothing until the model freely picks a face (fully dynamic, no preset).
DEFAULT_FACE=
