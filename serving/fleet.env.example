# fleet.env.example — copy to fleet.env and edit. NEVER commit fleet.env.
#
# SCOPE, stated exactly so this file does not promise more than it delivers: TODAY only two
# consumers source it — serving/promote_model.sh and serving/list_ep3_consumers.sh. It is the site
# config for MODEL PROMOTION and CONSUMER AUDIT, not yet a unified fleet config.
#
# The proxy services do NOT read this file: the systemd units load their own environment (see the
# unit's EnvironmentFile / Environment= lines), and the Python modules read os.environ directly.
# The variables below are documented for BOTH audiences — the ones marked (proxy) describe values
# the services expect in THEIR environment, so this file is a complete reference even where it is
# not yet the loader. Unifying that is a deliberate decision nobody has taken yet; until then,
# setting a (proxy) value here alone will NOT affect a running service.
#
# Variables with NO default FAIL LOUD when required, rather than silently defaulting to whatever
# host the author happened to use. A promotion that quietly targets the wrong machine is worse than
# one that refuses to start.
#
# File PATHS are fine to share and are not secrets. HOSTS and ADDRESSES must be configurable, which
# is why they are here rather than in the code.

# ── Serving nodes ───────────────────────────────────────────────────────────────────────────────
# Two serving nodes behind one stable alias. Which workloads a deployment places on which node is
# NOT decided here — promotion only ensures both nodes serve identical weights.
TAEY_NODE1_SSH=user@node1.example            # REQUIRED by promote_model.sh — ssh target
TAEY_NODE2_SSH=user@node2.example            # REQUIRED by promote_model.sh — ssh target
TAEY_NODE1_MODELS=/srv/taey/models           # REQUIRED — host dir mounted at /models in the server
TAEY_NODE2_MODELS=/srv/taey/models           # REQUIRED — host dir mounted at /models in the server
#TAEY_NODE1_HOST=node1.example               # defaults to the host part of TAEY_NODE1_SSH
#TAEY_NODE2_HOST=node2.example               # defaults to the host part of TAEY_NODE2_SSH
#TAEY_SERVE_HOSTS="node1.example node2.example"   # list_ep3_consumers.sh; falls back to the two above
#TAEY_SERVE_PORT=8000                        # OpenAI-compatible port on each serving node
#TAEY_SERVE_UNIT=taey-ep3.service            # systemd unit that serves the model
# Consumers PINNED to each node — the systemd --user units whose backend is that node. Promotion
# STOPS these for the maintenance window and restarts them after the node proves it serves, because
# the proxies have no admission gate and an idle-poll races new admission. Required to promote (use
# the literal `none` if there genuinely are none); not required for --check.
#TAEY_NODE1_CONSUMERS=taey-soma-proxy-mira.service
#TAEY_NODE2_CONSUMERS=taey-worker-proxy.service
#TAEY_SYNC_DRIVER=node1                      # which node drives rsync; it must be able to ssh to its
                                             # peer, and promote_model.sh proves that before --delete

# ── Model identity ──────────────────────────────────────────────────────────────────────────────
# The alias is STABLE; checkpoints are promoted behind it, so nothing downstream changes per release.
#TAEY_SERVED_NAME=ep3                        # alias every client asks for
#TAEY_MODEL_PATH=/srv/taey/models/<checkpoint>   # set per node by promote_model.sh; not usually here
#TAEY_MAX_MODEL_LEN=262144
#TAEY_QUANTIZATION=                          # empty = serve at the checkpoint's native precision
#TAEY_LORA_PATH=                             # optional adapter directory
#TAEY_LOAD_TIMEOUT=900                       # seconds to wait for a node to serve after restart

# ── Proxies (the executive and its delegate) — (proxy): NOT loaded from this file ───────────────
#PROXY_PORT=8766                             # executive proxy — this IS Taey
#VLLM_BASE_URL=http://node1.example:8000     # backend for THIS proxy
#TAEY_SESSION_NAME=taey                      # liveness namespace: taey:<name>:{idle,turns_open,...}
                                             # the delegate MUST set a DIFFERENT name, or it writes
                                             # the executive's liveness keys and declares it idle
                                             # mid-turn
#VLLM_REQUEST_TIMEOUT_SECS=1800
#VLLM_HEALTH_PROBE_TIMEOUT_SECS=10           # hard cap for /health catalogue + generation probes
#VLLM_HEALTH_CACHE_SECS=30                   # caches generation probe; polling must not join the queue

# ── Taey's identity and instructions — (proxy): NOT loaded from this file ───────────────────────
# Point these at a DEPLOYED checkout, never a working tree: a service reading its own identity from
# a dirty dev worktree is not a committed public artifact, and a branch switch there mutates the
# running system.
#SYSTEM_PROMPT_PATH=/srv/taey/checkout/serving/TAEY_OPERATING_PROMPT.md
#PERMANENT_KERNEL_PATH=                      # optional constitutional layer prefixed to the prompt

# ── Tool sandbox — (proxy): NOT loaded from this file ───────────────────────────────────────────
# EMPTY MEANS THE FILE-READ TOOLS ARE OFF. This is deliberately fail-closed: set it to the corpus and
# documentation directories you want readable, colon-separated, and keep it tight.
#TAEY_READ_ALLOWED_PREFIXES=/srv/taey/corpus:/tmp
#TAEY_TOOL_AUDIT=~/taey_tool_audit.jsonl     # every tool call is recorded here
#TAEY_CORPUS_STAGING=~/corpus_staging

# ── Seat runtime — (proxy): NOT loaded from this file ───────────────────────────────────────────
#TAEY_SEAT_PROXY=http://127.0.0.1:8766/v1/chat/completions   # the seat's own backend
#TAEY_SEAT_TIMEOUT=1800
#TAEY_SEAT_MAX_TURNS=60
#TAEY_SESSIONS_DIR=~/.local/state/taey/sessions

# ── Dashboard — (proxy): NOT loaded from this file ──────────────────────────────────────────────
# The dashboard's runtime panel reads the prefix-cache hit rate off a serving node over ssh. There
# is NO default: unset means the panel reports "unconfigured", which is the honest answer. It must
# never fall back to whichever host the author happened to use — that reports another machine's
# cache as if it were yours.
#TAEY_SERVE_NODE_SSH=user@node2.example       # falls back to TAEY_NODE2_SSH above
#TAEY_SERVE_UNIT=taey-ep3.service             # systemd unit whose journal holds the hit rate

# ── State — (proxy): NOT loaded from this file ──────────────────────────────────────────────────
#REDIS_HOST=127.0.0.1
#REDIS_PORT=6379

# --- dashboard (proxy) --------------------------------------------------------
# TAEY_THOR_RAW_URL — the DIRECT vLLM serve URL, bypassing the soma proxy. The
# dashboard's /api/health vLLM status light probes {TAEY_THOR_RAW_URL}/v1/models,
# and the non-proxy chat path posts to {TAEY_THOR_RAW_URL}/v1/chat/completions.
# Substituted into serving/systemd/taey-dashboard.service at install time in place
# of @TAEY_THOR_RAW_URL@. There is NO safe default: unset, the dashboard falls back
# to localhost:8000 and the status light reports a healthy serve as DOWN.
TAEY_THOR_RAW_URL=http://<thor1-host>:8000
