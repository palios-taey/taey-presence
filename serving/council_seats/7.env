# Council seat 7 — role mapping. Seat number and role are PARALLEL identifiers:
# the number is the liveness namespace notify addresses, the role is the lens this seat holds.
TAEY_COUNCIL_ROLE_ID=control-acceptance
TAEY_CONVERSATION_ID=council-control-acceptance
# RELATIVE on purpose — resolved against the unit's WorkingDirectory, so no operator path
# is baked in. Verified: the seat script does Path(value).expanduser() with no base, so a
# relative value stays relative and opens against cwd.
TAEY_COUNCIL_ROLE_PROMPT_PATH=serving/council_prompts/control-acceptance.md
