[Unit]
Description=Taey dashboard (UI server + native council transport)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@TAEY_ROOT@
Environment=HOME=@TAEY_HOME@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@TAEY_ROOT@/.env
Environment=REDIS_HOST=127.0.0.1
Environment=REDIS_PORT=6379
# Wave window sized from measurement, not hope: on 2026-08-11 a 7-seat wave took
# 11-21 min sharing the MAIN serve; with seats on the worker proxy (Thor2) and the
# bounded-contribution rule in council_prompts/shared.md, minutes — 900 s is the
# honest ceiling until bounded waves are re-measured. The previous 180 s window
# closed zero rounds ever: every seat delivered after the round was declared dead.
Environment=TAEY_COUNCIL_WAVE_TIMEOUT=900
# Synthesis + dashboard health target the MAIN soma proxy. Unset, THOR_PROXY
# falls back to CHAT_BASE (localhost:8000 — a dead port on this host): the
# council's synthesis step ConnectError'd there on the FIRST round ever to
# reach synthesis (2026-08-11 19:56, round dcm-20260811T192954Z).
Environment=THOR_PROXY=http://127.0.0.1:8766
# THOR_RAW is the DIRECT serve (bypassing the proxy) — site-specific, so it is
# substituted at install time from fleet.env's TAEY_THOR_RAW_URL and never
# committed as a literal. Unset, it fell back to CHAT_BASE (localhost:8000 —
# dead on this host), so the dashboard's vLLM status light probed a dead port and
# showed RED while the serve was healthy the whole time. Same defect class as
# THOR_PROXY above. A status light that lies is worse than no light: it reports
# an outage that is not happening.
Environment=THOR_RAW=@TAEY_THOR_RAW_URL@
ExecStart=/usr/bin/python3 @TAEY_HOME@/.local/bin/uvicorn dashboard.app:app --host 0.0.0.0 --port 5001
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
