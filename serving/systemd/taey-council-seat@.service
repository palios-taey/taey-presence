[Unit]
Description=Taey council seat %i (private supporting runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@TAEY_ROOT@
EnvironmentFile=@TAEY_ROOT@/serving/run/council-seat-%i.env
Environment=HOME=@TAEY_HOME@
Environment=PYTHONUNBUFFERED=1
ExecStart=@TAEY_VENV@/bin/python -u serving/taey_council_seat.py
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=10
TimeoutStopSec=300

[Install]
WantedBy=default.target
