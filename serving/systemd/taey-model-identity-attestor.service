# Serving-host authority for the short-lived Taey model identity receipt.
[Unit]
Description=Taey serving model identity attestor
BindsTo=taey-ep3.service
After=taey-ep3.service network-online.target
PartOf=taey-ep3.service

[Service]
Type=simple
User=root
Environment=TAEY_MODEL_PATH=@TAEY_MODEL_PATH@
Environment="TAEY_SERVED_NAME=ep3"
Environment=VLLM_PORT=8000
Environment=TAEY_MODEL_IDENTITY_MANIFEST=model.safetensors.index.json
EnvironmentFile=/etc/taey/model-identity-attestor.env
LoadCredential=model-identity-signing-key:/etc/taey/model-identity-attestor.key
ExecStart=/usr/bin/python3 @TAEY_ROOT@/serving/model_identity_attestor.py
TimeoutStartSec=1800
# HASH_CHUNK_BYTES=8388608 in model_identity_attestor.file_sha256.
# Observed stopped-cgroup MemoryPeak=7733358592 with MemoryMax=infinity during
# two full scans of a 55586117875-byte artifact (page cache, not the hasher).
# MemoryHigh=16*HASH_CHUNK=128M and MemoryMax=32*HASH_CHUNK=256M sit above the
# fixed buffer plus interpreter/fence metadata and force reclaim.
MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=256M
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=taey-model-identity-attestor

[Install]
WantedBy=multi-user.target
